{
    "version": "0.5.0",
    "description": "A small, fast, native desktop video downloader built on yt-dlp.",
    "homepage": "https://github.com/EmreO33/snag",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/EmreO33/snag/releases/download/v0.5.0/Snag-0.5.0-windows-portable.zip",
            "hash": "87404ce8cce2cc81b086eed7eaa58b52b2929be9fb08053db8b48fa17c6d7d62"
        }
    },
    "bin": "snag.exe",
    "shortcuts": [
        [
            "snag.exe",
            "Snag"
        ]
    ],
    "persist": "data",
    "notes": [
        "Snag does not ship yt-dlp. On first launch it offers to download the current release from the yt-dlp project's own GitHub releases.",
        "ffmpeg is required for merging and conversion and is not installed by Snag: 'scoop install ffmpeg' will do it.",
        "Your settings live in the persisted 'data' folder, so they survive updates and uninstalls."
    ],
    "suggest": {
        "ffmpeg": "ffmpeg"
    },
    "checkver": {
        "github": "https://github.com/EmreO33/snag"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/EmreO33/snag/releases/download/v$version/Snag-$version-windows-portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
